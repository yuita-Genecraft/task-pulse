# Example only. Do NOT deploy without approved account/db bindings and tokens.
name = "taskpulse-chatgpt"
main = "worker.mjs"
compatibility_date = "2026-10-10"
workers_dev = true

[observability]
enabled = true
redact_query_string = true

[observability.traces]
enabled = true
head_sampling_rate = 0.05

[[d1_databases]]
binding = "DB"
database_name = "taskpulse-chatgpt"
database_id = "REPLACE_WITH_APPROVED_D1_DATABASE_ID"
migrations_dir = "migrations"
