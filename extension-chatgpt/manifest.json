{
  "manifest_version": 3,
  "name": "Task Pulse — ChatGPT チャット登録",
  "version": "0.5.0",
  "description": "ClaudeセカンドオピニオンPJ内のChatGPTチャットだけをTask Pulseへ自動登録します。会話本文は取得しません。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://taskpulse-chatgpt.gooooerer.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yuita-genecraft.github.io/task-pulse/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
